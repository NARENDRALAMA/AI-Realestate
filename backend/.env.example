# Copy to .env for local runs (.env is git-ignored). Names only; never commit real values.
USE_LLM=true
LLM_BACKEND=ollama            # ollama (local) | workers_ai (cloud) | remote_http | local_transformers
LLM_MODEL_NAME=mistral        # Ollama tag
LLM_TIMEOUT_SECONDS=180
# Workers AI (LLM_BACKEND=workers_ai)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# Web
ALLOWED_ORIGINS=http://localhost:5173
DB_PATH=
ENABLE_API_DOCS=true
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_GENERATE=10/60
RATE_LIMIT_REFINE=30/60
RATE_LIMIT_AUTH=10/60
# Demo login created at startup
DEMO_EMAIL=
DEMO_PASSWORD=
